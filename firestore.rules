rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Since we are using an inclusive in-app PIN-based student logins to secure their profiles,
    // we bypass native request.auth constraints for user collections to allow seamless multi-device usage.
    match /users/{userId} {
      allow read, write: if true;
      
      match /routines/{routineId} {
        allow read, write: if true;
      }
      
      match /progress/{progressId} {
        allow read, write: if true;
      }

      match /rewards/{rewardId} {
        allow read, write: if true;
      }
    }

    match /activities/{activityId} {
      allow read, write: if true; // Allow teachers to configure activities
    }

    match /alerts/{alertId} {
      allow read, write: if true; // Anyone can send help alert, professor listens
    }
  }
}
